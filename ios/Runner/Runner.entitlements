<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Imprescindible para que la app y la extensión del widget compartan
	     el comando de pausa/reanudación. Debe existir también en el target
	     PulsoWidget con el MISMO identificador. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pulso.basket</string>
	</array>
</dict>
</plist>
